@model IEnumerable<task4.Models.User>

@{
    ViewData["Title"] = "User Management";
    string currentSort = ViewData["CurrentSort"] as string ?? "";
}

<div class="container-fluid">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
    }

    <form id="actionsForm" asp-action="Actions" method="post">
        @Html.AntiForgeryToken()
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="btn-toolbar gap-2" role="toolbar">
                <button type="submit" name="actionType" value="block" class="btn btn-outline-danger" data-bs-toggle="tooltip" title="Block selected">
                    Block
                </button>
                <button type="submit" name="actionType" value="unblock" class="btn btn-outline-success" data-bs-toggle="tooltip" title="Unblock">
                    <i class="bi bi-unlock-fill"></i>
                </button>
                <button type="submit" name="actionType" value="delete" class="btn btn-outline-secondary" data-bs-toggle="tooltip" title="Delete">
                    <i class="bi bi-trash-fill"></i>
                </button>
                <button type="submit" name="actionType" value="deleteUnverified" class="btn btn-outline-warning" data-bs-toggle="tooltip" title="Delete unverified">
                    <i class="bi bi-person-x-fill"></i>
                </button>
            </div>

            <button type="submit" asp-action="Logout" asp-controller="Account" formmethod="post" class="btn btn-outline-secondary">
                Log out
            </button>
        </div>

        <div class="table-responsive card shadow-sm border-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width: 40px;">
                            <input type="checkbox" id="selectAll" class="form-check-input" />
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSortParm" class="text-white text-decoration-none d-inline-flex align-items-center">
                                <span>Name</span>
                                <i class="bi @(currentSort == "name" ? "bi-arrow-up text-warning" : currentSort == "name_desc" ? "bi-arrow-down text-warning" : "bi-arrow-down-up text-white-50") ms-1" style="pointer-events: none;"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@ViewBag.EmailSortParm" class="text-white text-decoration-none d-inline-flex align-items-center">
                                <span>Email</span>
                                <i class="bi @(currentSort == "email" ? "bi-arrow-up text-warning" : currentSort == "email_desc" ? "bi-arrow-down text-warning" : "bi-arrow-down-up text-white-50") ms-1" style="pointer-events: none;"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@ViewBag.DateSortParm" class="text-white text-decoration-none d-inline-flex align-items-center">
                                <span>Last Login</span>
                                <i class="bi @(currentSort == "date" ? "bi-arrow-up text-warning" : currentSort == "date_desc" ? "bi-arrow-down text-warning" : "bi-arrow-down-up text-white-50") ms-1" style="pointer-events: none;"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@ViewBag.StatusSortParm" class="text-white text-decoration-none d-inline-flex align-items-center">
                                <span>Status</span>
                                <i class="bi @(currentSort == "status" ? "bi-arrow-up text-warning" : currentSort == "status_desc" ? "bi-arrow-down text-warning" : "bi-arrow-down-up text-white-50") ms-1" style="pointer-events: none;"></i>
                            </a>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" name="selectedIds" value="@user.Id" class="form-check-input user-checkbox" />
                            </td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@(user.LastLoginAt.HasValue ? user.LastLoginAt.Value.ToString("g") : "Never")</td>
                            <td>
                                @if (user.Status == "active")
                                {
                                    <span class="badge bg-success">active</span>
                                }
                                else if (user.Status.StartsWith("blocked"))
                                {
                                    <span class="badge bg-danger">blocked</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">unverified</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selectAll = document.getElementById('selectAll');
        if (selectAll) {
            selectAll.addEventListener('change', function() {
                const checkboxes = document.querySelectorAll('.user-checkbox');
                checkboxes.forEach(cb => cb.checked = this.checked);
            });
        }

        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        if (typeof bootstrap !== 'undefined') {
            [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
        }
    });
</script>